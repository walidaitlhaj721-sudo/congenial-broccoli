name: Build APK
on:
  workflow_dispatch:
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 17
      - uses: android-actions/setup-android@v3
      - uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: 8.7
      - name: Unpack project
        run: |
          echo '' | base64 -d | tar xz
      - name: Unit tests
        working-directory: VaeronApp
        run: gradle testDebugUnitTest
      - name: Build debug APK
        working-directory: VaeronApp
        run: gradle assembleDebug
      - uses: actions/upload-artifact@v4
        with:
          name: vaeron-debug-apk
          path: VaeronApp/app/build/outputs/apk/debug/app-debug.apk
